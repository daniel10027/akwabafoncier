# ================================================
# AkwabaFoncier — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ================================================

# --- Sécurité ---
SECRET_KEY=changez-cette-cle-secrete-en-production-minimum-50-chars
DEBUG=False
ALLOWED_HOSTS=akwabafoncier.ci,www.akwabafoncier.ci,localhost

# --- Base de données PostgreSQL ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=akwabafoncier_db
DB_USER=akwaba_user
DB_PASSWORD=votre_mot_de_passe_securise
DB_HOST=localhost
DB_PORT=5432

# --- Admin par défaut ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@akwabafoncier.ci
ADMIN_PASSWORD=MotDePasseSecurise2026!

# --- Email (Gmail SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@akwabafoncier.ci
EMAIL_HOST_PASSWORD=votre_app_password_gmail

# --- CinetPay ---
CINETPAY_API_KEY=votre_cle_api_cinetpay
CINETPAY_SITE_ID=votre_site_id
CINETPAY_NOTIFY_URL=https://akwabafoncier.ci/paiements/notify/
CINETPAY_RETURN_URL=https://akwabafoncier.ci/paiements/retour/

# --- URLs ---
SITE_URL=https://akwabafoncier.ci
